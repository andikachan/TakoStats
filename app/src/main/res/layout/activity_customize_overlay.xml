<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/customize_overlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Live Preview Box -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/preview"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="20dp"
                android:background="#20000000">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/preview_overlay_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="#A0000000"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/preview_overlay_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:padding="10dp"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="3"
                        android:text="FPS   60.0\nCPU   25.3 %\nGPU   18.5 %\nBAT   34.5 °C"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <!-- Metrics Toggle Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/metrics_data"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <CheckBox
                        android:id="@+id/cb_fps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_fps" />

                    <CheckBox
                        android:id="@+id/cb_layer_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_layer_name" />

                    <CheckBox
                        android:id="@+id/cb_cpu_usage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_cpu_usage" />

                    <CheckBox
                        android:id="@+id/cb_cpu_freq"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_cpu_freq" />

                    <CheckBox
                        android:id="@+id/cb_cpu_temp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_cpu_temp" />

                    <CheckBox
                        android:id="@+id/cb_gpu_usage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_gpu_usage" />

                    <CheckBox
                        android:id="@+id/cb_gpu_temp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_gpu_temp" />

                    <CheckBox
                        android:id="@+id/cb_bat_temp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_battery_temp" />

                    <CheckBox
                        android:id="@+id/cb_bat_cur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_battery_current" />

                    <CheckBox
                        android:id="@+id/cb_bat_volt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_battery_voltage" />

                    <CheckBox
                        android:id="@+id/cb_bat_pwr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_battery_power" />

                    <CheckBox
                        android:id="@+id/cb_mem_mb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_memory_mb" />

                    <CheckBox
                        android:id="@+id/cb_mem_pct"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_memory_pct" />

                    <CheckBox
                        android:id="@+id/cb_net_dl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_download_speed" />

                    <CheckBox
                        android:id="@+id/cb_net_ul"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_upload_speed" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Appearance & Behavior Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/appearance_behavior"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Text Size -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/text_size"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:id="@+id/text_text_size_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_text_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:max="24"
                        android:progress="12" />

                    <!-- Drag to Move Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/drag_to_move"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/drag_to_move_summary"
                                android:textAppearance="?attr/textAppearanceBodySmall" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_draggable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>

                    <!-- Background Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/show_background"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_background"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
