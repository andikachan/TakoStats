<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:title="Game Booster Engine" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Shizuku Permission Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardShizukuStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgShizukuIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_security_24"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvShizukuTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shizuku ADB Access"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvShizukuDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking Shizuku service status..."
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantShizuku"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grant"
                        android:visibility="gone"
                        style="@style/Widget.Material3.Button.TonalButton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode Selector Card (Extreme Beast vs Standard) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Optimization Profile"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvModeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#D32F2F"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="🔥 EXTREME BEAST"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvModeDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maximum uncapped performance. Thermal throttling bypassed, PowerHAL fixed clocks locked, 100% AOT native compilation, and background frozen."
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="6dp" />

                    <RadioGroup
                        android:id="@+id/rgBoostMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <RadioButton
                            android:id="@+id/rbExtremeBeast"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="🔥 Extreme Beast" />

                        <RadioButton
                            android:id="@+id/rbStandardBoost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ Standard" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Target Game Selector Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTargetGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target Game / Application"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:id="@+id/imgSelectedGameIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_stat_fps" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSelectedGameName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Select a game..."
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSelectedGamePackage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="No target package selected"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChangeGame"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Change"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCompileAotOnly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚡ Deep AOT Compilation (Primary + Split DEX)"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Device Spoofing Preset Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Device Identity &amp; Graphics Spoofing"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSpoofBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#616161"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="ORIGINAL"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSpoofDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spoof as Flagship Gaming Phone to unlock 90/120 FPS, or as Legacy Potato Phone to force low-poly ultra-light rendering on modern devices."
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectDeviceSpoof"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📱 Select Device Profile (Default: Original)"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Resolution & GPU Downscale Preset Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="GPU Render Resolution Downscaler"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResolutionBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#2E7D32"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="100% NATIVE"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Downscale display render resolution &amp; DPI to massively reduce GPU load and double framerates on heavy games."
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="6dp" />

                    <RadioGroup
                        android:id="@+id/rgResolutionPreset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp">

                        <RadioButton
                            android:id="@+id/rbResNative"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="🖥️ Native (100% - Default Sharpness)" />

                        <RadioButton
                            android:id="@+id/rbRes85"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚡ 85% Resolution (Ultra-Smooth + Balanced)" />

                        <RadioButton
                            android:id="@+id/rbRes70"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🚀 70% Resolution (High FPS / Heavy Games)" />

                        <RadioButton
                            android:id="@+id/rbRes50"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🔥 50% Resolution (Extreme Beast Max FPS)" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Tweaks Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Optimization Modules"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• 🔥 Thermal Throttling Bypass (cmd thermalservice override 0)\n• ⚡ PowerHAL Sustained Performance Lock\n• 🏎️ CPU Uclamp 100% (1024) &amp; SchedTune Prime-Core Boost\n• 🎮 GPU Devfreq Max Clocks &amp; Power Rails Forcing (kgsl/GED)\n• 🧠 Linux Kernel VM Memory Compaction &amp; Drop Caches\n• 🛡️ Anti-Kill OOM Shield (-1000) for Target Game\n• 🎯 Android Game Intervention &amp; ANGLE Vulkan Driver\n• 🚀 Deep AOT Compilation (Primary + Split DEX)\n• 🖥️ SurfaceFlinger Early Phase Zero-Latency Offsets\n• 👆 Low Input Delay (Touch Slop 2px) &amp; FIFO UI Scheduling\n• 📶 Wi-Fi Low-Latency Mode &amp; TCP QuickACK Ping Booster\n• 🛑 App Standby Freeze (Restricted) &amp; Background Purge\n• 🚫 Disable Virtual RAM / RAM Plus (Anti-Stutter)\n• 🔕 Total Game DND &amp; Disable Heads-Up Popups\n• 💥 Kill Joyose &amp; Samsung GOS Throttlers"
                        android:textSize="12.5sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thermal & Memory Watchdog Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real-Time Hardware Watchdog"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <!-- Battery Temp Metric -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Battery Temp"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/tvBatteryTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--.- °C"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvThermalThrottleWarning"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Throttling Risk"
                                android:textColor="#E53935"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutline" />

                        <!-- Available RAM Metric -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Free Physical RAM"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/tvAvailableRam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- MB"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvLowRamWarning"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Low RAM (&lt;400MB)"
                                android:textColor="#E53935"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressRamUsage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:trackCornerRadius="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Controls Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Execute Optimization"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBoost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        android:indeterminate="true" />

                    <TextView
                        android:id="@+id/tvBoostProgressMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boosting..."
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBoostAndLaunch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚀 BOOST &amp; LAUNCH GAME"
                        android:layout_marginTop="16dp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBoostNow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚡ QUICK SYSTEM BOOST ONLY"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestoreDefaults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔄 RESTORE SYSTEM DEFAULTS"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Boost Results / Logs Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBoostResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Optimization Execution Report"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBoostResultsLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
